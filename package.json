{
  "name": "story-river",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "immediately.run": {
    "$schema": "https://immediately.run/immediately-run-config.schema.json",
    "opens": [
      {
        "app": "self",
        "version": "^1"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@immediately-run/grove": "0.2.7",
    "@immediately-run/sdk": "^0.90.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "overrides": {
    "@immediately-run/sdk": "$@immediately-run/sdk"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@immediately-run/dev-fs": "^0.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^25.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^3.0.5"
  }
}
